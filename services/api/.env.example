# ============================================================
# 研脉学术知识付费平台 · API 服务配置模板
# 复制为 .env.local 后填入真实值（.env.local 已被 .gitignore 忽略）
# ============================================================

# ---------- 应用 ----------
APP_NAME=yanmai-api
# 运行环境：local | dev | staging | prod
APP_ENV=local

# ---------- HTTP ----------
HTTP_HOST=0.0.0.0
HTTP_PORT=8080
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=10s
# 允许跨域的前端来源，逗号分隔
HTTP_CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175
# 单 IP 限流（令牌桶）
HTTP_RATE_LIMIT_RPS=50
HTTP_RATE_LIMIT_BURST=100

# ---------- 数据库（云 PostgreSQL）----------
# 腾讯云示例：postgres://yanmai:密码@10.0.0.5:5432/yanmai_dev?sslmode=require
# 注意：连接串含密码，切勿提交到 Git
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/yanmai_dev?sslmode=require
DB_MAX_OPEN_CONNS=20
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=30m
# 空闲连接的最大存活时间。云数据库（Neon / PgBouncer / 云厂商托管）会主动断开
# 长时间空闲的连接，而 Go 连接池默认不主动淘汰空闲连接，会出现「池里握着一条已被
# 对端关闭的连接」，下个请求直接失败。此处应短于对端的空闲断开时间。
DB_CONN_MAX_IDLE_TIME=4m
# 健康检查单次探测超时。跨地域云数据库（尤其本机走代理时）新建连接需数秒，
# 该值过紧会让 /health 常态误报降级。
DB_PING_TIMEOUT=5s
# 启动时自动执行 golang-migrate 迁移（本地/联调建议 true，生产建议 false 改为发布流程执行）
DB_AUTO_MIGRATE=true
# 写入种子账号（仅本地联调使用，生产必须为 false）
DB_SEED=true

# ---------- 认证 ----------
# 生产环境请使用 openssl rand -hex 32 生成，长度不少于 32 位
JWT_SECRET=please-change-me-to-a-random-string-at-least-32-chars
JWT_ISSUER=yanmai-api
JWT_ACCESS_TTL=2h
JWT_REFRESH_TTL=168h

# ---------- Redis（Phase 1 可留空，队列会降级为禁用状态）----------
REDIS_ADDR=
REDIS_PASSWORD=
REDIS_DB=0

# ---------- 日志 ----------
# debug | info | warn | error
LOG_LEVEL=debug
